rules_version = '2';
// BeatFinder 신청곡 보안 규칙
// - 누구나 목록을 읽고 새 신청곡을 쓸 수 있어요 (형식·길이 검사)
// - 수정은 ♥(likes)를 1 올리는 것만 가능해요
// - 삭제와 "틀었어요" 표시(status: "played")는 Firebase 콘솔에서 주인만 해요
service cloud.firestore {
  match /databases/{database}/documents {
    function okText(v, max) { return v is string && v.size() <= max; }
    function okUrl(v) { return v is string && v.size() <= 500 && (v == '' || v.matches('https://.*')); }

    match /requests/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
            ['title', 'artist', 'name', 'message', 'art', 'preview', 'url', 'likes', 'status', 'createdAt'])
        && okText(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && okText(request.resource.data.artist, 200)
        && okText(request.resource.data.name, 30)
        && okText(request.resource.data.message, 200)
        && okUrl(request.resource.data.art)
        && okUrl(request.resource.data.preview)
        && okUrl(request.resource.data.url)
        && request.resource.data.likes == 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;

      allow delete: if false;
    }
  }
}
